{
  "name": "dsh-annals",
  "version": "0.6.0",
  "type": "module",
  "description": "日志系统：注册 annals 技能、常驻注入日志规矩、轮次收尾提醒补写、一次初始化（日志目录 + 索引生成器 + git）。",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "ARCHITECTURE.md",
    "LIMITATIONS.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/offline.mjs test/build-index.test.mjs test/links.test.mjs test/version.test.mjs test/e2e-sandbox.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duhuashan/dsh-annals.git"
  },
  "homepage": "https://github.com/duhuashan/dsh-annals#readme",
  "bugs": {
    "url": "https://github.com/duhuashan/dsh-annals/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "keywords": [
    "dsh",
    "annals",
    "logging",
    "journal"
  ],
  "license": "MIT"
}
